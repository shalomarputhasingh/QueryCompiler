# Path of the SQLite sample database (created and seeded automatically on first use).
# If the location is not writable (e.g. read-only/serverless file systems) the app falls
# back to a seeded in-memory database.
SQLITE_PATH=./data/querycompiler.db

# Quera (AI tutor) — get a free key at https://console.groq.com/keys
# Server-side only: never prefix with NEXT_PUBLIC_.
GROQ_API_KEY=
# Optional overrides
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
# QUERA_MAX_WAIT_MS=240000
